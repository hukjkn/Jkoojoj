workflow_dispatch:

jobs:
  launch-kali:
    runs-on: ubuntu-latest
    timeout-minutes: 360

    steps:
      - name: ًں“¦ Setup Kali Linux Engine & Web Terminal (TTYD)
        run: |
          echo "=========================================================="
          echo "  ًں›،ï¸ڈ INSTALLING KALI LINUX & HACKING SUITE..."
          echo "=========================================================="
          sudo apt-get update -y -q
          
          # ظ†طµط¨ ع©ظ„ظˆط¯ظپظ„ط±ط¯
          wget -q https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 -O /usr/local/bin/cloudflared
          sudo chmod +x /usr/local/bin/cloudflared

          # ظ†طµط¨ ظˆط¨â€Œطھط±ظ…غŒظ†ط§ظ„ ظ‚ط¯ط±طھظ…ظ†ط¯ ttyd
          sudo wget -q https://github.com/tsl0922/ttyd/releases/download/1.7.7/ttyd.x86_64 -O /usr/local/bin/ttyd
          sudo chmod +x /usr/local/bin/ttyd

          # ط§ط¬ط±ط§غŒ ع©ط§ظ†طھغŒظ†ط± ط±ط³ظ…غŒ ع©ط§ظ„غŒ ظ„غŒظ†ظˆع©ط³ ط¨ط§ ط¯ط³طھط±ط³غŒ ط±ظˆطھ ع©ط§ظ…ظ„
          docker run -d \
            --name cynet-kali \
            --privileged \
            --network host \
            -v /root:/root \
            kalilinux/kali-rolling \
            tail -f /dev/null

          # ظ†طµط¨ ط§ط¨ط²ط§ط±ظ‡ط§غŒ ط§طµظ„غŒ ع©ط§ظ„غŒ ط¯ط± ظ¾ط³â€Œط²ظ…غŒظ†ظ‡
          docker exec cynet-kali apt-get update -y
          docker exec cynet-kali apt-get install -y -q nmap metasploit-framework sqlmap hydra curl wget python3 git sudo zsh tmux

      - name: ًںŒگ Launch Interactive Web Terminal & Public Link
        run: |
          echo "=========================================================="
          echo "  ًںژ‰ LAUNCHING INTERACTIVE KALI WEB TERMINAL..."
          echo "=========================================================="
          
          # ط§ط¬ط±ط§غŒ ظˆط¨ طھط±ظ…غŒظ†ط§ظ„ ط¨ط§ ظپظ„ع¯ -W ط¨ط±ط§غŒ ظپط¹ط§ظ„â€Œط³ط§ط²غŒ ع©ط§ظ…ظ„ طھط§غŒظ¾ ظˆ ع©غŒط¨ظˆط±ط¯
          ttyd -W -p 7681 -t fontSize=16 -t theme='{"background": "#0f172a", "foreground": "#38bdf8", "cursor": "#38bdf8"}' docker exec -it cynet-kali /bin/bash > /dev/null 2>&1 &
          sleep 3

          # ط§غŒط¬ط§ط¯ طھط§ظ†ظ„ ع©ظ„ظˆط¯ظپظ„ط±
          cloudflared tunnel --url http://localhost:7681 > tunnel.log 2>&1 &
          
          sleep 5
          for i in {1..20}; do
            URL=$(grep -o 'https://[a-zA-Z0-9-]*\.trycloudflare\.com' tunnel.log | head -n 1)
            if [ -n "$URL" ]; then
              echo ""
              echo "=========================================================="
              echo "  ًں”¥ YOUR INTERACTIVE KALI LINUX IS LIVE & READY!"
              echo "  ًں‘‰ CLICK TO OPEN IN BROWSER: $URL"
              echo "  --------------------------------------------------------"
              echo "  âڑ، Full Root Access | 1000 Mbps Internet | Keyboard Active"
              echo "=========================================================="
              echo ""
              break
            fi
            sleep 2
          done

          tail -f tunnel.log
